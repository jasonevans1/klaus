{
  "extraKnownMarketplaces": {
    "laravel-factory": {
      "source": {
        "source": "github",
        "repo": "jasonevans1/laravel-factory"
      }
    }
  },
  "enabledPlugins": {
    "laravel-factory@laravel-factory": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/acceptance-specs.php\" guard"
          }
        ]
      }
    ]
  }
}
